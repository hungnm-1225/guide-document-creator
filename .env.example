# Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Mặc định gemini-3.5-flash-lite: 500 RPD)
GEMINI_MODEL=gemini-3.5-flash-lite

# TTS Settings (VieNeu-TTS & Edge-TTS)
TTS_ENGINE_VI=vieneu
VIENEU_VOICE=Ái Hân
VIENEU_MODE=v3nano

# Edge-TTS Voices
TTS_VOICE_VI=vi-VN-HoaiMyNeural
TTS_VOICE_EN=en-US-AriaNeural

# Browser Automation Settings
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Video Settings
VIDEO_FPS=24
VIDEO_TRANSITION_SECS=0.5
