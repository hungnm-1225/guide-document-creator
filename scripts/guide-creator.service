[Unit]
Description=Guide Document Creator - Automated User-Guide Content Factory
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/guide-document-creator
EnvironmentFile=/home/ubuntu/projects/guide-document-creator/.env
ExecStart=/home/ubuntu/projects/guide-document-creator/venv/bin/python main.py web --host 0.0.0.0 --port 8000 --no-open-browser
Restart=always
RestartSec=5

# ==============================================================================
# UNLEASHED MODE: BUNG HẾT SỨC MẠNH PHẦN CỨNG (FULL CPU & RAM)
# Chạy dự án tuần tự, giải phóng 100% công lực chip i3 Haswell và toàn bộ RAM vật lý
# ==============================================================================
# Ưu tiên CPU tiêu chuẩn (Nice=0) để biên dịch video và chạy crawler với tốc độ tối đa
Nice=0

# Không khống chế CPUQuota (để chip bung hết 100% cả 2 nhân 4 luồng)
# Không khống chế MemoryMax (để ứng dụng tự do dùng toàn bộ RAM có sẵn + 3.7GB Swap)

# Logging ra journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=guide-creator

[Install]
WantedBy=multi-user.target
